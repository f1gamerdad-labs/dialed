<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net8.0-windows</TargetFramework>
    <UseWindowsForms>true</UseWindowsForms>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <AssemblyName>Dialed</AssemblyName>
    <RootNamespace>TunerApp</RootNamespace>
    <Version>0.1.0</Version>
    <Product>Dialed</Product>
    <Company>F1GamerDad</Company>
    <AssemblyTitle>Dialed: Sim Graphics Optimiser</AssemblyTitle>
    <ApplicationIcon>..\assets\app.ico</ApplicationIcon>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.Web.WebView2" Version="1.0.2792.45" />
    <PackageReference Include="System.Diagnostics.PerformanceCounter" Version="8.0.0" />
    <PackageReference Include="System.Management" Version="8.0.0" />
  </ItemGroup>

  <!-- The web page the app shows. These are the same files the browser version uses. -->
  <ItemGroup>
    <Content Include="..\index.html" Link="web\index.html" CopyToOutputDirectory="PreserveNewest" />
    <Content Include="..\app.js" Link="web\app.js" CopyToOutputDirectory="PreserveNewest" />
    <Content Include="..\bridge.js" Link="web\bridge.js" CopyToOutputDirectory="PreserveNewest" />
    <Content Include="..\ui.js" Link="web\ui.js" CopyToOutputDirectory="PreserveNewest" />
    <Content Include="..\intro.js" Link="web\intro.js" CopyToOutputDirectory="PreserveNewest" />
    <Content Include="..\warn.js" Link="web\warn.js" CopyToOutputDirectory="PreserveNewest" />
    <Content Include="..\report.js" Link="web\report.js" CopyToOutputDirectory="PreserveNewest" />
    <Content Include="..\news.js" Link="web\news.js" CopyToOutputDirectory="PreserveNewest" />
    <Content Include="..\tour.js" Link="web\tour.js" CopyToOutputDirectory="PreserveNewest" />
    <Content Include="..\pc-check.js" Link="web\pc-check.js" CopyToOutputDirectory="PreserveNewest" />
    <Content Include="..\prefs.js" Link="web\prefs.js" CopyToOutputDirectory="PreserveNewest" />
    <Content Include="..\profiles.js" Link="web\profiles.js" CopyToOutputDirectory="PreserveNewest" />
    <Content Include="..\troubleshoot.js" Link="web\troubleshoot.js" CopyToOutputDirectory="PreserveNewest" />
    <Content Include="..\badges.js" Link="web\badges.js" CopyToOutputDirectory="PreserveNewest" />
    <Content Include="..\whatsnew.js" Link="web\whatsnew.js" CopyToOutputDirectory="PreserveNewest" />
    <Content Include="..\community.js" Link="web\community.js" CopyToOutputDirectory="PreserveNewest" />
    <Content Include="..\share-card.js" Link="web\share-card.js" CopyToOutputDirectory="PreserveNewest" />
    <Content Include="..\timeline-view.js" Link="web\timeline-view.js" CopyToOutputDirectory="PreserveNewest" />
    <Content Include="..\reliability.js" Link="web\reliability.js" CopyToOutputDirectory="PreserveNewest" />
    <Content Include="..\retest.js" Link="web\retest.js" CopyToOutputDirectory="PreserveNewest" />
    <Content Include="..\celebrate.js" Link="web\celebrate.js" CopyToOutputDirectory="PreserveNewest" />
    <Content Include="..\sims.js" Link="web\sims.js" CopyToOutputDirectory="PreserveNewest" />
    <Content Include="..\settings-table-lmu.js" Link="web\settings-table-lmu.js" CopyToOutputDirectory="PreserveNewest" />
    <Content Include="..\settings-table-ams2.js" Link="web\settings-table-ams2.js" CopyToOutputDirectory="PreserveNewest" />
    <Content Include="..\settings-table-acc.js" Link="web\settings-table-acc.js" CopyToOutputDirectory="PreserveNewest" />
    <Content Include="..\settings-table-beamng.js" Link="web\settings-table-beamng.js" CopyToOutputDirectory="PreserveNewest" />
    <Content Include="..\looks.js" Link="web\looks.js" CopyToOutputDirectory="PreserveNewest" />
    <Content Include="..\settings-table-pmr.js" Link="web\settings-table-pmr.js" CopyToOutputDirectory="PreserveNewest" />
    <Content Include="..\settings-table-raceroom.js" Link="web\settings-table-raceroom.js" CopyToOutputDirectory="PreserveNewest" />
    <Content Include="..\settings-table-evo.js" Link="web\settings-table-evo.js" CopyToOutputDirectory="PreserveNewest" />
    <Content Include="..\config.js" Link="web\config.js" CopyToOutputDirectory="PreserveNewest" />
    <Content Include="..\version.json" Link="web\version.json" CopyToOutputDirectory="PreserveNewest" />
    <Content Include="..\styles.css" Link="web\styles.css" CopyToOutputDirectory="PreserveNewest" />
    <Content Include="..\assets\**\*" Exclude="..\assets\app.ico" Link="web\assets\%(RecursiveDir)%(Filename)%(Extension)" CopyToOutputDirectory="PreserveNewest" />
    <Content Include="..\core.js" Link="web\core.js" CopyToOutputDirectory="PreserveNewest" />
    <Content Include="..\settings-table.js" Link="web\settings-table.js" CopyToOutputDirectory="PreserveNewest" />
    <Content Include="tools\**" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>

</Project>


